{
  "name": "@snack/mini",
  "version": "0.1.0",
  "private": true,
  "description": "uni-app 前端 —— 一个代码库出 4 端：mp-weixin（学生端主包 + 商户端分包）、h5（商户网页 /admin + 平台后台 /platform）",
  "scripts": {
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "check:styles": "node scripts/check-tokens.mjs",
    "check:token-refs": "node scripts/check-token-refs.mjs",
    "dev:mp": "uni -p mp-weixin",
    "dev:h5": "uni",
    "build:mp": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "check:build": "node scripts/check-build.mjs",
    "typecheck": "node scripts/sync-tokens.mjs && node scripts/check-tokens.mjs && node scripts/check-token-refs.mjs && vue-tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run build:mp && npm run check:build",
    "lint:styles": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020720260921001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020720260921001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020720260921001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020720260921001",
    "pinia": "2.1.7",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020720260921001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020720260921001",
    "@uni-helper/uni-app-types": "^1.3.0",
    "@vue/runtime-core": "3.4.21",
    "typescript": "^5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "^2.0.29"
  }
}
