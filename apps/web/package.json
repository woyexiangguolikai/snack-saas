{
  "name": "@snack/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "商户网页后台（W-01~W-11）—— 批量与配置能力：库存矩阵、批量导入、时间窗、账单导出",
  "scripts": {
    "dev": "npm run tokens:sync && vite",
    "build": "npm run tokens:sync && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:token-refs": "node scripts/check-token-refs.mjs",
    "check:platform-neutral": "node scripts/check-platform-neutral.mjs",
    "verify": "npm run tokens:sync && npm run check:tokens && npm run check:token-refs && npm run check:platform-neutral && npm run typecheck && npm run build"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
