# ---------------------------------------------------------------------------
# 服务端环境变量模板 —— 复制为 .env 后填写
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# 持久化模式：memory（本机 / CI）| mysql（生产）
DB_MODE=memory

# 生产：平台库（1 个）
PLATFORM_DATABASE_URL=mysql://root:root@127.0.0.1:3306/snack_platform
# 生产：租户库连接模板，{db} 会替换为 tenants.db_name（每租户独立库，D3）
TENANT_DATABASE_URL_TEMPLATE=mysql://root:root@127.0.0.1:3306/{db}

# 会话令牌密钥 —— 生产必须换成高强度随机值，禁止沿用默认值
JWT_SECRET=dev-only-secret-change-me

# ---------------------------------------------------------------------------
# 微信小程序凭据（学生登录 code2session 用）
# AppID 同时也填在 apps/mini/src/manifest.json（小程序端只读，不写 Secret）
# ⚠️ AppSecret 等同密码：只进服务端环境变量（.env.local，已被 .gitignore 忽略）
#    一旦泄露需在公众平台【重置】，重置后旧密钥立即失效
# ---------------------------------------------------------------------------
WECHAT_APPID=
WECHAT_APPSECRET=
# 允许直传 openid 登录（仅供自动化测试）。生产必须留空 / false
WECHAT_ALLOW_INSECURE_OPENID=true

# 微信支付商户号未开通前，用它跑通「接单→配送→送达→退款」闭环（生产必须 false）
DEV_PAY_SIMULATE=true

# 平台后台访问密钥 —— 过渡方案，上线前替换为账号体系 + RBAC + 操作审计
PLATFORM_ADMIN_KEY=dev-platform-key

# 单域名 + AppID 换租户；兜底路径前缀（§2.2）
API_PREFIX=/api
TENANT_PATH_PREFIX=/t

LOG_LEVEL=info
