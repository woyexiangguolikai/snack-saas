{
  "name": "@snack/server",
  "version": "0.1.0",
  "private": true,
  "description": "多租户服务端：平台库 + 租户库路由、双账本、楼栋库存矩阵、上线流水线",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "start": "node dist/main.js",
    "smoke": "tsc -p tsconfig.json && node dist/smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma && prisma validate --schema prisma/tenant/schema.prisma",
    "db:migrate:platform": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:tenant": "prisma migrate deploy --schema prisma/tenant/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@snack/tokens": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
